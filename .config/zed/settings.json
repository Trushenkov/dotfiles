// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  //BASE
  "cli_default_open_behavior": "new_window",
  "base_keymap": "JetBrains",
  "git_commit_buffer_font_size": 16,

  "cursor_shape": "bar",
  "cursor_blink": true,
  "cursor_animation": {
    "enabled": true,
  },

  "inlay_hints": {
    "enabled": true,
    "show_background": true,
    "show_other_hints": true,
    "show_parameter_hints": true,
    "show_type_hints": true,
    "show_value_hints": true,
  },

  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },

  "toolbar": {
    "selections_menu": true,
    "quick_actions": false,
    "breadcrumbs": true,
  },

  "terminal": {
    "font_size": 16.0,
    "font_family": "JetBrainsMono Nerd Font",
    "toolbar": {
      "breadcrumbs": true,
    },
    "default_height": 300,
    "button": false,
    "copy_on_select": true,
  },

  //THEME
  "theme": {
    "mode": "dark",
    "light": "Islands Light",
    "dark": "Moonlight Italic",
  },
  "icon_theme": {
    "mode": "light",
    "light": "Base Charmed Icons",
    "dark": "Colored Zed Icons Theme Dark",
  },

  //EDITOR
  "buffer_line_height": "comfortable",
  "buffer_font_size": 17.0,
  "buffer_font_family": "JetBrains Mono",

  //UI
  "ui_font_family": "JetBrains Mono",
  "ui_font_size": 18.0,
  "minimap": {
    "show": "never",
  },

  //PANELS
  "outline_panel": {
    "dock": "left",
    "button": false,
  },
  "collaboration_panel": {
    "dock": "left",
    "button": false,
  },
  "project_panel": {
    "git_status_indicator": true,
    "bold_folder_labels": true,
    "diagnostic_badges": true,
    "dock": "left",
    "entry_spacing": "standard",
    "hide_root": true,
    "indent_guides": {
      "show": "never",
    },
  },
  "git_panel": {
    "dock": "left",
    "group_by": "staging",
    "sort_by": "name",
    "show_count_badge": true,
    "tree_view": true,
  },

  //FORMATTING
  "format_on_save": "on",
  "prettier": {
    "parser": "",
    "allowed": true,
    "plugins": ["eslint-plugin-prettier"],
  },
  "languages": {
    "TypeScript": {
      "format_on_save": "on",
      "code_actions_on_format": {
        "source.fixAll.eslint": true,
      },
    },
    "JavaScript": {
      "format_on_save": "on",
      "code_actions_on_format": {
        "source.fixAll.eslint": true,
      },
    },
    "HTML": {
      "format_on_save": "on",
      "formatter": "auto",
      "code_actions_on_format": {
        "source.fixAll.eslint": true,
      },
    },
    "CSS": {
      "format_on_save": "on",
      "formatter": "prettier",
    },
    "SCSS": {
      "format_on_save": "on",
      "formatter": "prettier",
    },
    "JSON": {
      "format_on_save": "on",
      "formatter": "prettier",
    },
    "JSONC": {
      "format_on_save": "on",
      "formatter": "prettier",
    },
    "Markdown": {
      "format_on_save": "on",
      "formatter": "prettier",
    },
  },

  //LSP
  "lsp": {
    "angular": {
      "initialization_options": {
        "angular_language_server_path": "/Users/trushenkov/.local/share/angular-ls/node_modules/@angular/language-server",
      },
    },
    "some-sass-lsp": {
      "settings": { "loadPaths": ["ws-style"] },
    },
    // "scss-lsp": {
    //   "settings": { "loadPaths": ["ws-style"] },
    // },
    // "vscode-css-language-server": {
    //   "settings": { "loadPaths": ["ws-style"] },
    // },
  },
}
